{
  "name": "@signoff/xrpl",
  "version": "0.1.0",
  "private": true,
  "description": "XRP Ledger helpers for SignOff: Testnet provisioning, signer configuration, two-signature payments and reconciliation.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@signoff/shared": "0.1.0",
    "xrpl": "5.3.0",
    "zod": "4.6.7"
  }
}
