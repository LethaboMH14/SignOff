{
  "name": "@signoff/agent",
  "version": "0.1.0",
  "private": true,
  "description": "The invoice agent. It reads a text PDF, extracts source-cited fields, checks them against the buyer's evidence and proposes a payment. It holds no payment key and cannot submit a transaction.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json",
    "serve": "tsx src/main.ts"
  },
  "dependencies": {
    "imapflow": "2.10.0",
    "jpeg-js": "0.4.4",
    "mailparser": "3.14.1",
    "pdfjs-dist": "6.5.438",
    "pngjs": "7.0.0",
    "tesseract.js": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pngjs": "6.0.5",
    "opentype.js": "2.0.0"
  }
}
