{
  "name": "signoff",
  "version": "0.1.0",
  "private": true,
  "description": "An AI accounts-payable agent that cannot move money alone. Testnet only.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "packages/shared",
    "packages/xrpl",
    "packages/warden-api",
    "apps/agent",
    "apps/console",
    "apps/warden"
  ],
  "overrides": {
    "minimatch": "11.0.5"
  },
  "scripts": {
    "prepare": "node scripts/setup-hooks.mjs",
    "setup:hooks": "node scripts/setup-hooks.mjs",
    "secrets:scan": "tsx scripts/secret-scan.ts --all",
    "attack": "tsx scripts/attack-suite.ts",
    "testnet:provision": "tsx scripts/testnet/gate-a.ts provision",
    "testnet:signers": "tsx scripts/testnet/gate-a.ts signers",
    "testnet:pay": "tsx scripts/testnet/gate-a.ts pay",
    "testnet:pay-rlusd": "tsx scripts/testnet/gate-a.ts pay-rlusd",
    "testnet:rejections": "tsx scripts/testnet/gate-a.ts rejections",
    "testnet:timeout": "tsx scripts/testnet/gate-a.ts timeout",
    "testnet:failover": "tsx scripts/testnet/gate-a.ts failover",
    "testnet:rebuild": "tsx scripts/testnet/gate-a.ts rebuild",
    "testnet:gate-b": "tsx scripts/testnet/gate-b.ts",
    "testnet:synthetic": "tsx scripts/testnet/synthetic.ts",
    "testnet:credential": "tsx scripts/testnet/credential.ts",
    "judge:check": "tsx scripts/judge-check.ts",
    "fx:demo": "tsx scripts/fx-demo.ts",
    "audit:verify": "tsx scripts/audit-verify.ts",
    "eval": "tsx apps/agent/src/main.ts eval --mode fixture",
    "agent:eval": "tsx apps/agent/src/main.ts eval",
    "agent:run": "tsx apps/agent/src/main.ts run",
    "agent:export": "tsx apps/agent/src/main.ts export",
    "agent:build-set": "tsx apps/agent/tools/build-labelled-set.ts",
    "warden:serve": "npm run serve --workspace @signoff/warden",
    "console:serve": "npm run serve --workspace @signoff/console",
    "console:operator": "tsx apps/console/src/server/operator-cli/main.ts",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --project tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run secrets:scan && npm run test:coverage && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-security": "4.2.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
