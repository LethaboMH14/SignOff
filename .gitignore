# Dependencies and build output
node_modules/
dist/
coverage/
*.tsbuildinfo

# Secrets and local environment (rule R-12). Only the example template is tracked.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
id_rsa
id_dsa
id_ecdsa
id_ed25519

# Local-only notes and transcripts. They can contain other people's personal data.
/notes/

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Agent runtime data: the watched inbox holds invoices, and the state folder holds the decision log. Neither is committed.
/apps/agent/inbox/
/apps/agent/state/
# Generated fictional invoices: rebuilt by `npm run gen:invoices`; only labels.json and the
# generator are committed (binary files are large and reproducible from the seed).
/apps/agent/fixtures/generated/**/*.pdf
/apps/agent/fixtures/generated/**/*.png
/apps/agent/fixtures/generated/**/*.jpg

# Local-only dataset downloads (licence-restricted; used for measurement, never committed).
/.local-datasets/
