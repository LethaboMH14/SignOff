# Copy this file to .env at the repo root and fill in the values you have. .env is gitignored; this template is tracked.
# Keep every value empty here. Never commit a real key, and never paste one into an issue, a log or a chat.
# The agent reads these at run time. A missing key is reported by its name only.
# The OpenRouter, Groq and Gemini links were not re-checked on 2026-11-12; the AI/ML API and Hugging Face links were.

# --- Model providers (apps/agent). Each key is optional: set only the provider you use. ---

# OpenRouter. Free signup and key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Groq. Free signup and key: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini API. Free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Meta API. Key and address come from your Meta account. The address must be https with no credentials, query or fragment.
META_API_KEY=
META_API_BASE_URL=

# AI/ML API (UNVERIFIED default model; see apps/agent/src/model/providers.ts). Free signup: https://aimlapi.com/app/sign-up
# Key page: https://aimlapi.com/app/keys
AIML_API_KEY=

# Hugging Face Inference Providers (UNVERIFIED default model). Create a fine-grained token with the Inference Providers
# permission: https://huggingface.co/settings/tokens/new?ownUserPermissions=inference.serverless.write&tokenType=fineGrained
HF_TOKEN=

# --- Agent identity (apps/agent, when it submits to the Warden). Hex values; see apps/agent/README.md. ---
SIGNOFF_AGENT_ID=
SIGNOFF_AGENT_SECRET=
SIGNOFF_AGENT_SEED=
