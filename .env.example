# SignOff: local environment template.
#
# Copy to .env (`cp .env.example .env`) and fill in only what you need. .env is ignored by git; never commit it.
# Testnet only: no main-network key, no real funds, no real personal data (docs/RULES.md, R-11 and R-12).
#
# Nothing here is needed for the offline checks (`npm run check`, `npm run attack`, `npm run judge:check`) or for
# `npm run demo:verify`. Ledger accounts, seeds and the Warden's keys are NOT set here: `npm run testnet:provision`
# and `npm run demo:prepare` write them to your local SignOff folder, outside the repository.

# --- Model provider for the agent (one is enough; `npm run demo` uses Groq unless --provider says otherwise) ---
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional alternatives, used by `npm run agent:eval -- --provider <name>`
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Meta's API: the key and the https address it is sent to (`npm run demo -- --provider meta --model <id>`)
META_API_KEY=
META_API_BASE_URL=

# --- Emailed invoices (`npm run demo -- --email`, see docs/EMAIL-DEMO.md) ---
# A Gmail address that only this demo uses, and a Google app password for it (not the account password).
SIGNOFF_MAIL_USER=
SIGNOFF_MAIL_PASSWORD=
# Comma-separated addresses whose invoices are admitted; mail from anyone else is quarantined.
SIGNOFF_MAIL_ALLOWED_SENDERS=
# Optional overrides: defaults are imap.gmail.com, 993 and mx.google.com
SIGNOFF_MAIL_HOST=
SIGNOFF_MAIL_PORT=
SIGNOFF_MAIL_AUTHSERV=

# --- High-value payments: the owner approves on their phone in Xaman (docs/HIGH-VALUE.md) ---
# From https://apps.xumm.dev (Testnet). The approver address is the owner's Xaman Testnet account.
XAMAN_API_KEY=
XAMAN_API_SECRET=
XAMAN_APPROVER_ADDRESS=
# Optional: a push token from a first approval, so the request reaches the phone without a link or QR
XAMAN_USER_TOKEN=

# --- Owner notices (optional; without these, notices go to the console and the log only) ---
# Address the demo mailbox sends owner notices to
OWNER_NOTIFY_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Rand payout to the supplier (optional; SIMULATED locally without a key) ---
# A Paystack TEST key only (sk_test_...). A live key is refused.
PAYSTACK_SECRET_KEY=
PAYSTACK_TEST_ACCOUNT=
PAYSTACK_TEST_BANK_CODE=

# --- Console overrides (optional; `npm run demo` sets these for you, see apps/console/README.md) ---
# SIGNOFF_WARDEN_URL=http://127.0.0.1:8789
# SIGNOFF_CONSOLE_MODE=live
# SIGNOFF_CONSOLE_PORT=4180
# SIGNOFF_DEMO_RAND_PER_UNIT=
# SIGNOFF_LOCAL_DIR=
